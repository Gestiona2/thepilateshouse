---
const { ratio = "3 / 4", clase = "" } = Astro.props;
---
<div class:list={["arco", clase]} style={`--r:${ratio}`}><slot /></div>

<style>
  .arco {
    aspect-ratio: var(--r);
    border-radius: 999px 999px 0 0;
    overflow: hidden;
    background: var(--arena);
  }
  .arco :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
